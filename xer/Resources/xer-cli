#!/bin/bash
set -euo pipefail

XER_BUNDLE_ID="dev.anuz.xer"
XER_APP="${XER_APP:-}"

resolve_xer_app() {
  if [[ -n "$XER_APP" && -d "$XER_APP" ]]; then
    return 0
  fi

  local app_path=""
  app_path="$(/usr/bin/mdfind "kMDItemCFBundleIdentifier == '$XER_BUNDLE_ID'" 2>/dev/null | /usr/bin/head -n 1 || true)"
  if [[ -n "$app_path" && -d "$app_path" ]]; then
    XER_APP="$app_path"
    return 0
  fi

  for candidate in "/Applications/xer.app" "$HOME/Applications/xer.app"; do
    if [[ -d "$candidate" ]]; then
      XER_APP="$candidate"
      return 0
    fi
  done

  echo "xer: could not locate the xer application. Install xer or reinstall the command from xer › Console › Terminal." >&2
  exit 1
}

urlencode() {
  /usr/bin/python3 - <<'PY' "$1"
import sys, urllib.parse
print(urllib.parse.quote(sys.argv[1], safe="/"))
PY
}

resolve_directory() {
  local target="${1:-.}"
  if [[ "$target" == "." ]]; then
    /bin/pwd -P
    return 0
  fi

  if [[ ! -e "$target" ]]; then
    echo "xer: no such file or directory: $target" >&2
    return 1
  fi

  (
    cd "$target" 2>/dev/null || {
      echo "xer: not a directory: $target" >&2
      exit 1
    }
    /bin/pwd -P
  )
}

find_xcode_context() {
  local start_path="$1"
  local current="$start_path"

  if [[ ! -d "$current" ]]; then
    echo "xer: choose a folder, not a file." >&2
    return 1
  fi

  while [[ "$current" != "/" ]]; do
    case "$current" in
      *.xcodeproj|*.xcworkspace)
        printf '%s\n' "$current"
        return 0
        ;;
    esac

    local match=""
    local ext item
    for ext in xcworkspace xcodeproj; do
      for item in "$current"/*."$ext"; do
        [[ -e "$item" ]] || continue
        match="$current"
        break
      done
      [[ -n "$match" ]] && break
    done

    if [[ -n "$match" ]]; then
      printf '%s\n' "$match"
      return 0
    fi

    current="$(/usr/bin/dirname "$current")"
  done

  echo "xer: no .xcworkspace or .xcodeproj found in or above $start_path." >&2
  return 1
}

open_in_xer() {
  local path="$1"
  resolve_xer_app
  /usr/bin/open -a "$XER_APP" --url "xer://open?path=$(urlencode "$path")"
}

is_xer_running() {
  [[ -n "$XER_APP" && -d "$XER_APP" ]] || return 1
  /usr/bin/pgrep -fq "${XER_APP}/Contents/MacOS/" 2>/dev/null
}

refresh_in_xer() {
  resolve_xer_app
  if ! is_xer_running; then
    echo "xer: xer is not running. Open xer and run an app first." >&2
    exit 1
  fi

  echo "Refreshing app..."
  /usr/bin/open -g -a "$XER_APP" --url "xer://refresh"
  echo "Refreshed app."
}

usage() {
  cat <<'EOF'
Usage:
  xer [path]         Open path in xer, importing it when needed (. means current directory)
  xer open [path]    Same as xer [path]
  xer refresh        Reload the app currently running in xer without bringing xer forward

Examples:
  xer .
  xer /path/to/repo
  xer refresh
EOF
}

main() {
  local command="open"
  local target="."

  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help|help)
        usage
        exit 0
        ;;
      open)
        command="$1"
        shift
        target="${1:-.}"
        ;;
      refresh)
        command="$1"
        shift
        ;;
      *)
        target="$1"
        ;;
    esac
  fi

  case "$command" in
    open)
      local directory=""
      directory="$(resolve_directory "$target")"
      local context=""
      context="$(find_xcode_context "$directory")"
      open_in_xer "$context"
      ;;
    refresh)
      refresh_in_xer
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
